{
  "name": "bolas-al-ritmo",
  "version": "0.7.2",
  "private": true,
  "description": "Vídeos verticales de una bola que toca una canción: cada choque suena la nota del MIDI. Web + motor de render.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "node scripts/sync-assets.mjs",
    "instruments": "node scripts/build-instruments.mjs",
    "render": "tsx src/cli/render.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/web.e2e.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "app": "npm run app:prepare && electron .",
    "app:prepare": "node scripts/sync-assets.mjs && node scripts/build-renderer.mjs && node electron/build.mjs",
    "app:build": "npm run app:prepare && electron-builder --publish never",
    "app:publish": "npm run app:prepare && electron-builder --publish always",
    "test:app": "npm run app:prepare && xvfb-run -a node tests/e2e/app.smoke.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@napi-rs/canvas": "^1.1.1",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tonejs/midi": "^2.0.28",
    "electron-updater": "^6.8.11",
    "mp4-muxer": "^5.2.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "main": "electron/dist/main.cjs",
  "author": {
    "name": "h00agui"
  }
}
